@model AerolineaVIP.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Recuperar acceso";
}
@* Pantalla 4. Recuperación de acceso con mensaje neutral. *@
<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3 text-center">Recuperar acceso</h1>
        <p class="text-center text-muted">Ingrese el correo o nombre de usuario asociado a su cuenta.</p>
        @if (ViewBag.Advertencia != null)
        {
            <div class="alert alert-warning" role="alert"><strong>Advertencia:</strong> @ViewBag.Advertencia</div>
        }
        @if (ViewBag.Informacion != null)
        {
            <div class="alert alert-info" role="status"><strong>Información:</strong> @ViewBag.Informacion</div>
        }
        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { @class = "tarjeta", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            <div class="mb-3">
                @Html.LabelFor(m => m.UsuarioOCorreo, new { @class = "form-label" }) <span class="req">*</span>
                @Html.TextBoxFor(m => m.UsuarioOCorreo, new { @class = "form-control", placeholder = "correo@ejemplo.com", maxlength = 256 })
                @Html.ValidationMessageFor(m => m.UsuarioOCorreo)
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary" data-texto-carga="Enviando solicitud…">Solicitar recuperación</button>
                @Html.ActionLink("Volver al inicio de sesión", "Login", null, new { @class = "btn btn-outline-secondary" })
            </div>
        }
        <p class="texto-ayuda mt-3">Simulación académica: no se envían correos reales. El enlace de recuperación se registra en la ventana «Salida» de Visual Studio para las pruebas.</p>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
