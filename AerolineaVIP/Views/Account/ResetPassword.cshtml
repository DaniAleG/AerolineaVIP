@model AerolineaVIP.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Restablecer contraseña";
}
<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3 text-center">Restablecer contraseña</h1>
        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { @class = "tarjeta", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })
            @Html.HiddenFor(m => m.Code)
            <div class="mb-3">
                @Html.LabelFor(m => m.Email, new { @class = "form-label" }) <span class="req">*</span>
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                @Html.ValidationMessageFor(m => m.Email)
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Password, new { @class = "form-label" }) <span class="req">*</span>
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "new-password" })
                <div class="texto-ayuda">Mínimo 8 · mayúscula · minúscula · número · símbolo</div>
                @Html.ValidationMessageFor(m => m.Password)
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" }) <span class="req">*</span>
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword)
            </div>
            <button type="submit" class="btn btn-primary" data-texto-carga="Guardando…">Restablecer</button>
        }
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
