@model AerolineaVIP.Models.LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
}
@* Pantalla 2. Inicio de sesión con nombre de usuario (o correo) y contraseña. *@
<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3 text-center mb-3">Iniciar sesión</h1>
        @if (ViewBag.Advertencia != null)
        {
            <div class="alert alert-warning" role="alert"><strong>Advertencia:</strong> @ViewBag.Advertencia</div>
        }
        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "tarjeta", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
            {
                <div class="alert alert-danger" role="alert"><strong>Error de acceso:</strong> @ViewData.ModelState[""].Errors.First().ErrorMessage</div>
            }
            <div class="mb-3">
                @Html.LabelFor(m => m.UsuarioOCorreo, new { @class = "form-label" }) <span class="req">*</span>
                @Html.TextBoxFor(m => m.UsuarioOCorreo, new { @class = "form-control", placeholder = "usuario o correo@ejemplo.com", autocomplete = "username", maxlength = 256, autofocus = "autofocus" })
                @Html.ValidationMessageFor(m => m.UsuarioOCorreo)
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Password, new { @class = "form-label" }) <span class="req">*</span>
                <div class="input-group">
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password" })
                    <button type="button" class="btn btn-outline-secondary" data-mostrar="#Password" aria-pressed="false" aria-label="Mostrar u ocultar la contraseña">Mostrar</button>
                </div>
                @Html.ValidationMessageFor(m => m.Password)
            </div>
            <div class="form-check mb-3">
                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.RememberMe, new { @class = "form-check-label" })
            </div>
            <div class="d-grid">
                <button type="submit" class="btn btn-primary" data-texto-carga="Verificando…">Iniciar sesión</button>
            </div>
            <p class="mt-3 mb-0 text-center small">
                @Html.ActionLink("¿Olvidó su contraseña?", "ForgotPassword") · @Html.ActionLink("Crear cuenta", "Register")
            </p>
        }
        <details class="mt-3 small text-muted">
            <summary>Usuarios de demostración (creados por código)</summary>
            <ul class="mt-2">
                <li><strong>superusuario</strong> / Super.Vip2026! — SuperUsuario</li>
                <li><strong>admin01</strong> / Admin.Vip2026! — Administrador</li>
                <li><strong>counter01</strong> / Counter.Vip2026! — Empleado de counter</li>
                <li><strong>cliente01</strong> … <strong>cliente05</strong> / Cliente.Vip2026! — Cliente (con reservas de demostración)</li>
            </ul>
        </details>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
