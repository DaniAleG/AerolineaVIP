@model AerolineaVIP.Models.Dominio.Asiento
@{
    ViewBag.Title = "Detalle de asiento";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Distribución de asientos", "Index")</li>
    <li class="breadcrumb-item active" aria-current="page">Detalle</li>
</ol></nav>
<h1 class="h3">Detalle de asiento</h1>
<div class="tarjeta">
    <dl class="row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ModeloAeronaveId)</dt>
        <dd class="col-sm-8">@(Model.ModeloAeronave.Fabricante + " " + Model.ModeloAeronave.Nombre)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NumeroAsiento)</dt>
        <dd class="col-sm-8">@(Model.NumeroAsiento)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Codigo)</dt>
        <dd class="col-sm-8">@(Model.Codigo)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Fila)</dt>
        <dd class="col-sm-8">@(Model.Fila)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Lado)</dt>
        <dd class="col-sm-8">@(AerolineaVIP.Servicios.Formato.NombreLado(Model.Lado))</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Ubicacion)</dt>
        <dd class="col-sm-8">@(Model.Ubicacion)</dd>
    </dl>
</div>
<div class="mt-3 d-flex gap-2">
    @if (User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario)) { @Html.ActionLink("Editar", "Edit", new { modeloAeronaveId = Model.ModeloAeronaveId, numeroAsiento = Model.NumeroAsiento }, new { @class = "btn btn-primary" }) }
    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>
