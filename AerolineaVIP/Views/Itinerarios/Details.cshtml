@model AerolineaVIP.Models.Dominio.Itinerario
@{
    ViewBag.Title = "Detalle de itinerario";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Itinerarios", "Index")</li>
    <li class="breadcrumb-item active" aria-current="page">Detalle</li>
</ol></nav>
<h1 class="h3">Detalle de itinerario</h1>
<div class="tarjeta">
    <dl class="row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Referencia)</dt>
        <dd class="col-sm-8">@(Model.Referencia)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dd class="col-sm-8">@(Model.Nombre)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.EstadoItinerarioCodigo)</dt>
        <dd class="col-sm-8"><span class="@AerolineaVIP.Servicios.Formato.ClaseEstado(Model.EstadoItinerarioCodigo)">@(Model.EstadoItinerario.Descripcion)</span></dd>
    </dl>
</div>
<div class="mt-3 d-flex gap-2">
    @if ((User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario) || User.IsInRole(AerolineaVIP.RolesApp.Administrador))) { @Html.ActionLink("Editar", "Edit", new { id = Model.ItinerarioId }, new { @class = "btn btn-primary" }) }
    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>
