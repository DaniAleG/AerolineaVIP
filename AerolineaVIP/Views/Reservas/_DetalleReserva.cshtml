@model DetalleReservaVM
@* Itinerario, pasajeros y asientos de una reserva (pantallas 12 y 14). *@
<div class="table-responsive">
    <table class="table align-middle mb-0 tabla-apilada">
        <thead>
            <tr>
                <th scope="col">Tramo</th><th scope="col">Vuelo</th><th scope="col">Ruta</th><th scope="col">Fecha</th><th scope="col">Horario</th>
                <th scope="col">Pasajero</th><th scope="col">Asiento</th><th scope="col">Estado del asiento</th><th scope="col" class="text-end">Importe</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model.Lineas)
            {
                <tr>
                    <td data-label="Tramo">@l.Orden</td>
                    <td data-label="Vuelo">@l.CodigoVuelo</td>
                    <td data-label="Ruta">@l.Ruta</td>
                    <td data-label="Fecha">@Formato.Fecha(l.Fecha)</td>
                    <td data-label="Horario">@Formato.Horario(l.Salida, l.Llegada)</td>
                    <td data-label="Pasajero">@l.Pasajero<br /><span class="texto-ayuda">@l.Documento</span></td>
                    <td data-label="Asiento" class="fw-bold">@l.Asiento</td>
                    <td data-label="Estado del asiento">
                        @{
                            var visual = l.EstadoAsignacion == "PENDIENTE" ? "Reservado (morado)" : l.EstadoAsignacion == "CONFIRMADA" ? "Ocupado (rojo)" : l.EstadoAsignacion == "CANCELADA" ? "Cancelado (liberado)" : "Liberado por expiración";
                        }
                        <span class="@Formato.ClaseEstado(l.EstadoAsignacion)">@visual</span>
                        @if (l.CheckIn != null) { <span class="@Formato.ClaseEstado(l.CheckIn)">Check-in @l.CheckIn.ToLower()</span> }
                    </td>
                    <td data-label="Importe" class="text-end">@Formato.Dinero(l.Importe)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr><th colspan="8" class="text-end">Total</th><td class="text-end total">@Formato.Dinero(Model.Total)</td></tr>
        </tfoot>
    </table>
</div>
