@model AerolineaVIP.Models.Dominio.ModeloAeronave
@{
    ViewBag.Title = "Detalle de modelo de aeronave";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Modelos de aeronave", "Index")</li>
    <li class="breadcrumb-item active" aria-current="page">Detalle</li>
</ol></nav>
<h1 class="h3">Detalle de modelo de aeronave</h1>
<div class="tarjeta">
    <dl class="row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Fabricante)</dt>
        <dd class="col-sm-8">@(Model.Fabricante)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dd class="col-sm-8">@(Model.Nombre)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CapacidadAsientos)</dt>
        <dd class="col-sm-8">@(Model.CapacidadAsientos)</dd>
    </dl>
</div>
<div class="mt-3 d-flex gap-2">
    @if (User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario)) { @Html.ActionLink("Editar", "Edit", new { id = Model.ModeloAeronaveId }, new { @class = "btn btn-primary" }) }
    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>
