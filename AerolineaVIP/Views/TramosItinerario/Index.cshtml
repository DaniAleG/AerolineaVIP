@model IEnumerable<AerolineaVIP.Models.Dominio.TramoItinerario>
@{
    ViewBag.Title = "Tramos de itinerario";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Mantenimientos", "Mantenimientos", "Admin")</li>
    <li class="breadcrumb-item active" aria-current="page">Tramos de itinerario</li>
</ol></nav>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h1 class="h3 mb-0">Tramos de itinerario</h1>
    @if ((User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario) || User.IsInRole(AerolineaVIP.RolesApp.Administrador)))
    {
        @Html.ActionLink("Crear nuevo", "Create", null, new { @class = "btn btn-primary" })
    }
</div>
@if (ViewBag.Nota != null)
{
    <p class="text-muted small">@ViewBag.Nota</p>
}
@if (!Model.Any())
{
    <div class="alert alert-info" role="status">No se encontraron registros.</div>
}
else
{
    <div class="table-responsive tarjeta p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th scope="col">@Html.DisplayNameFor(model => model.ItinerarioId)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Orden)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.VueloId)</th>
                <th scope="col" class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
@foreach (var item in Model)
{
            <tr>
                <td>@(item.Itinerario.Referencia)</td>
                <td>@(item.Orden)</td>
                <td>@("VIP" + item.VueloId.ToString("00000") + " · " + AerolineaVIP.Servicios.Formato.Fecha(item.Vuelo.FechaOperacion) + " · " + item.Vuelo.Frecuencia.Ruta.AeropuertoOrigen.CodigoIATA + " → " + item.Vuelo.Frecuencia.Ruta.AeropuertoDestino.CodigoIATA + " " + AerolineaVIP.Servicios.Formato.Hora(item.Vuelo.Frecuencia.HoraSalida))</td>
                <td class="text-end text-nowrap">
                    @if ((User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario) || User.IsInRole(AerolineaVIP.RolesApp.Administrador))) { @Html.ActionLink("Editar", "Edit", new { id = item.TramoItinerarioId }, new { @class = "btn btn-sm btn-outline-primary" }) }
                    @Html.ActionLink("Detalles", "Details", new { id = item.TramoItinerarioId }, new { @class = "btn btn-sm btn-outline-secondary" })
                    @if ((User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario) || User.IsInRole(AerolineaVIP.RolesApp.Administrador))) { @Html.ActionLink("Eliminar", "Delete", new { id = item.TramoItinerarioId }, new { @class = "btn btn-sm btn-outline-danger" }) }
                </td>
            </tr>
}
            </tbody>
        </table>
    </div>
}
