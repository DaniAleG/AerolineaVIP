@model AerolineaVIP.Models.Dominio.MetodoPago
@{
    ViewBag.Title = "Eliminar método de pago";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Métodos de pago (simulación)", "Index")</li>
    <li class="breadcrumb-item active" aria-current="page">Eliminar</li>
</ol></nav>
<h1 class="h3">Eliminar método de pago</h1>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert"><strong>Error:</strong> @ViewBag.Error</div>
}
else
{
    <div class="alert alert-warning" role="alert"><strong>Advertencia:</strong> ¿Está seguro de que desea eliminar este registro? Esta acción no se puede deshacer.</div>
}
<div class="tarjeta">
    <dl class="row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Codigo)</dt>
        <dd class="col-sm-8">@(Model.Codigo)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dd class="col-sm-8">@(Model.Nombre)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Activo)</dt>
        <dd class="col-sm-8">@(Model.Activo ? "Sí" : "No")</dd>
    </dl>
</div>
@using (Html.BeginForm("Delete", "MetodosPago", new { id = Model.Codigo }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-danger">Eliminar</button>
        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}
