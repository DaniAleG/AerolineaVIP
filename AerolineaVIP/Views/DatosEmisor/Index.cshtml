@model IEnumerable<AerolineaVIP.Models.Dominio.DatosEmisor>
@{
    ViewBag.Title = "Datos del emisor del comprobante";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Mantenimientos", "Mantenimientos", "Admin")</li>
    <li class="breadcrumb-item active" aria-current="page">Datos del emisor del comprobante</li>
</ol></nav>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h1 class="h3 mb-0">Datos del emisor del comprobante</h1>
    @if (false)
    {
        @Html.ActionLink("Crear nuevo", "Create", null, new { @class = "btn btn-primary" })
    }
</div>
@if (ViewBag.Nota != null)
{
    <p class="text-muted small">@ViewBag.Nota</p>
}
@if (!Model.Any())
{
    <div class="alert alert-info" role="status">No se encontraron registros.</div>
}
else
{
    <div class="table-responsive tarjeta p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th scope="col">@Html.DisplayNameFor(model => model.NombreComercial)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Identificacion)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Direccion)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.LeyendaComprobante)</th>
                <th scope="col" class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
@foreach (var item in Model)
{
            <tr>
                <td>@(item.NombreComercial)</td>
                <td>@(item.Identificacion)</td>
                <td>@(item.Direccion)</td>
                <td>@(item.LeyendaComprobante)</td>
                <td class="text-end text-nowrap">
                    @if (User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario)) { @Html.ActionLink("Editar", "Edit", new { id = item.DatosEmisorId }, new { @class = "btn btn-sm btn-outline-primary" }) }
                    @Html.ActionLink("Detalles", "Details", new { id = item.DatosEmisorId }, new { @class = "btn btn-sm btn-outline-secondary" })
                    @if (false) { @Html.ActionLink("Eliminar", "Delete", new { id = item.DatosEmisorId }, new { @class = "btn btn-sm btn-outline-danger" }) }
                </td>
            </tr>
}
            </tbody>
        </table>
    </div>
}
