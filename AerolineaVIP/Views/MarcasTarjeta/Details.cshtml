@model AerolineaVIP.Models.Dominio.MarcaTarjeta
@{
    ViewBag.Title = "Detalle de marca de tarjeta";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Marcas de tarjeta (simulación)", "Index")</li>
    <li class="breadcrumb-item active" aria-current="page">Detalle</li>
</ol></nav>
<h1 class="h3">Detalle de marca de tarjeta</h1>
<div class="tarjeta">
    <dl class="row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Codigo)</dt>
        <dd class="col-sm-8">@(Model.Codigo)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dd class="col-sm-8">@(Model.Nombre)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.LongitudNumero)</dt>
        <dd class="col-sm-8">@(Model.LongitudNumero)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.LongitudCodigoSeguridad)</dt>
        <dd class="col-sm-8">@(Model.LongitudCodigoSeguridad)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PrefijosReferencia)</dt>
        <dd class="col-sm-8">@(Model.PrefijosReferencia)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.RutaLogo)</dt>
        <dd class="col-sm-8"><img src="@Url.Content(Model.RutaLogo)" alt="" class="logo-tarjeta-mini" onerror="this.style.display='none'" /></dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Activa)</dt>
        <dd class="col-sm-8">@(Model.Activa ? "Sí" : "No")</dd>
    </dl>
</div>
<div class="mt-3 d-flex gap-2">
    @if (User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario)) { @Html.ActionLink("Editar", "Edit", new { id = Model.Codigo }, new { @class = "btn btn-primary" }) }
    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>
