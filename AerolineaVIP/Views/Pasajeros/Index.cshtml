@model IEnumerable<AerolineaVIP.Models.Dominio.Pasajero>
@{
    ViewBag.Title = "Pasajeros";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Mantenimientos", "Mantenimientos", "Admin")</li>
    <li class="breadcrumb-item active" aria-current="page">Pasajeros</li>
</ol></nav>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h1 class="h3 mb-0">Pasajeros</h1>
    @if ((User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario) || User.IsInRole(AerolineaVIP.RolesApp.Administrador)))
    {
        @Html.ActionLink("Crear nuevo", "Create", null, new { @class = "btn btn-primary" })
    }
</div>
@if (ViewBag.Nota != null)
{
    <p class="text-muted small">@ViewBag.Nota</p>
}
@if (!Model.Any())
{
    <div class="alert alert-info" role="status">No se encontraron registros.</div>
}
else
{
    <div class="table-responsive tarjeta p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th scope="col">@Html.DisplayNameFor(model => model.NumeroDocumento)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Apellidos)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Correo)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Telefono)</th>
                <th scope="col" class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
@foreach (var item in Model)
{
            <tr>
                <td>@(item.TipoDocumentoIdentidad.Descripcion + " " + item.NumeroDocumento)</td>
                <td>@(item.Apellidos + ", " + item.Nombres)</td>
                <td>@(item.Correo)</td>
                <td>@(item.Telefono)</td>
                <td class="text-end text-nowrap">
                    @if ((User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario) || User.IsInRole(AerolineaVIP.RolesApp.Administrador))) { @Html.ActionLink("Editar", "Edit", new { id = item.PasajeroId }, new { @class = "btn btn-sm btn-outline-primary" }) }
                    @Html.ActionLink("Detalles", "Details", new { id = item.PasajeroId }, new { @class = "btn btn-sm btn-outline-secondary" })
                    @if ((User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario) || User.IsInRole(AerolineaVIP.RolesApp.Administrador))) { @Html.ActionLink("Eliminar", "Delete", new { id = item.PasajeroId }, new { @class = "btn btn-sm btn-outline-danger" }) }
                </td>
            </tr>
}
            </tbody>
        </table>
    </div>
}
