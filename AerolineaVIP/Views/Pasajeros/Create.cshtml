@model AerolineaVIP.Models.Dominio.Pasajero
@{
    ViewBag.Title = "Nuevo registro: pasajero";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Pasajeros", "Index")</li>
    <li class="breadcrumb-item active" aria-current="page">Crear</li>
</ol></nav>
<h1 class="h3">Nuevo registro: pasajero</h1>
<p class="text-muted small">Los campos marcados con <span class="req">*</span> son obligatorios.</p>
@using (Html.BeginForm("Create", "Pasajeros", null, FormMethod.Post, new { @class = "tarjeta js-form-carga", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })
    <div class="row g-3">
            <div class="col-md-6">
                @Html.LabelFor(model => model.TipoDocumentoCodigo, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.DropDownList("TipoDocumentoCodigo", null, "Seleccione…", htmlAttributes: new { @class = "form-select" })
                @Html.ValidationMessageFor(model => model.TipoDocumentoCodigo, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.NumeroDocumento, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.EditorFor(model => model.NumeroDocumento, new { htmlAttributes = new { @class = "form-control", style = "text-transform:uppercase" } })
                @Html.ValidationMessageFor(model => model.NumeroDocumento, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.Nombres, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.EditorFor(model => model.Nombres, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Nombres, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.Apellidos, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.EditorFor(model => model.Apellidos, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Apellidos, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.FechaNacimiento, htmlAttributes: new { @class = "form-label" }) 
                @Html.EditorFor(model => model.FechaNacimiento, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.FechaNacimiento, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.Correo, htmlAttributes: new { @class = "form-label" }) 
                @Html.EditorFor(model => model.Correo, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Correo, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.Telefono, htmlAttributes: new { @class = "form-label" }) 
                @Html.EditorFor(model => model.Telefono, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Telefono, "", new { @class = "text-danger small", role = "alert" })
            </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary" data-texto-carga="Guardando…">Guardar</button>
        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
