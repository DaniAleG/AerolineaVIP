@model DetalleReservaVM
@{
    ViewBag.Title = "Confirmación";
    var r = Model.Reserva;
}
@* Pantalla 12. Confirmación de compra o reserva: solo datos persistidos y estados reales. *@
<h1 class="h3">@(r.EstadoReservaCodigo == "CONFIRMADA" ? "Compra confirmada" : "Resultado de la operación")</h1>

@if (r.EstadoReservaCodigo == "CONFIRMADA" && Model.EstadoPago == "APROBADO")
{
    <div class="alert alert-success" role="status"><strong>Confirmación:</strong> Compra @r.CodigoReserva pagada. Pago simulado aprobado @Model.UltimoPago.CodigoOperacion.</div>
}
else if (r.EstadoReservaCodigo == "PENDIENTE" && Model.EstadoPago == "RECHAZADO")
{
    <div class="alert alert-danger" role="alert"><strong>Error comercial:</strong> El pago simulado fue rechazado. La reserva sigue pendiente.</div>
}
else if (r.EstadoReservaCodigo == "PENDIENTE")
{
    <div class="alert alert-info" role="status"><strong>Información:</strong> Reserva registrada. La compra continúa pendiente de pago.</div>
}

@Html.Partial("~/Views/Reservas/_EstadosOperacion.cshtml", Model)

<div class="tarjeta mb-3">
    <h2 class="tarjeta-titulo">Detalle</h2>
    @Html.Partial("~/Views/Reservas/_DetalleReserva.cshtml", Model)
    @if (Model.UltimoPago != null && Model.UltimoPago.EstadoPagoCodigo == "APROBADO")
    {
        <p class="mt-3 mb-0 text-end"><strong>Método:</strong> @Model.UltimoPago.MetodoPago.Nombre · @Model.UltimoPago.MarcaTarjeta.Nombre **** @Model.UltimoPago.UltimosCuatroDigitos</p>
    }
</div>

<div class="d-flex flex-wrap gap-2">
    <a class="btn btn-outline-primary" href="@Url.Action("Gestionar", "Reservas", new { id = r.ReservaId })">Ver reserva</a>
    @if (Model.EstadoCompra == "PAGADA")
    {
        <a class="btn btn-primary" href="@Url.Action("Index", "Comprobantes", new { Buscar = r.CodigoReserva })">Consultar comprobante</a>
    }
    @if (r.EstadoReservaCodigo == "PENDIENTE")
    {
        <a class="btn btn-primary" href="@Url.Action("Pagar", new { id = r.ReservaId })">@(Model.EstadoPago == "RECHAZADO" ? "Reintentar pago" : "Pagar ahora")</a>
    }
    <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Home")">Volver al inicio</a>
</div>
