@model AerolineaVIP.Models.Dominio.Frecuencia
@{
    ViewBag.Title = "Editar frecuencia";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Frecuencias aprobadas", "Index")</li>
    <li class="breadcrumb-item active" aria-current="page">Editar</li>
</ol></nav>
<h1 class="h3">Editar frecuencia</h1>
<p class="text-muted small">Los campos marcados con <span class="req">*</span> son obligatorios.</p>
@using (Html.BeginForm("Edit", "Frecuencias", new { id = Model.FrecuenciaId }, FormMethod.Post, new { @class = "tarjeta js-form-carga", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })
    <div class="row g-3">
            <div class="col-md-6">
                @Html.LabelFor(model => model.RutaId, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.DropDownList("RutaId", null, "Seleccione…", htmlAttributes: new { @class = "form-select" })
                @Html.ValidationMessageFor(model => model.RutaId, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.DiaSemana, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.DropDownList("DiaSemana", null, "Seleccione…", htmlAttributes: new { @class = "form-select" })
                @Html.ValidationMessageFor(model => model.DiaSemana, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.HoraSalida, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.EditorFor(model => model.HoraSalida, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.HoraSalida, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.HoraLlegada, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.EditorFor(model => model.HoraLlegada, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.HoraLlegada, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check">
                    @Html.CheckBoxFor(model => model.Activa, new { @class = "form-check-input" })
                    @Html.LabelFor(model => model.Activa, htmlAttributes: new { @class = "form-check-label" })
                </div>
            </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary" data-texto-carga="Guardando…">Guardar</button>
        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
