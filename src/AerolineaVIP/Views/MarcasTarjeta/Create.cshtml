@model AerolineaVIP.Models.Dominio.MarcaTarjeta
@{
    ViewBag.Title = "Nuevo registro: marca de tarjeta";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Marcas de tarjeta (simulación)", "Index")</li>
    <li class="breadcrumb-item active" aria-current="page">Crear</li>
</ol></nav>
<h1 class="h3">Nuevo registro: marca de tarjeta</h1>
<p class="text-muted small">Los campos marcados con <span class="req">*</span> son obligatorios.</p>
@using (Html.BeginForm("Create", "MarcasTarjeta", null, FormMethod.Post, new { @class = "tarjeta js-form-carga", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })
    <div class="row g-3">
            <div class="col-md-6">
                @Html.LabelFor(model => model.Codigo, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.EditorFor(model => model.Codigo, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Codigo, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.Nombre, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.LongitudNumero, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.EditorFor(model => model.LongitudNumero, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.LongitudNumero, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.LongitudCodigoSeguridad, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.EditorFor(model => model.LongitudCodigoSeguridad, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.LongitudCodigoSeguridad, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.PrefijosReferencia, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.EditorFor(model => model.PrefijosReferencia, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.PrefijosReferencia, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.RutaLogo, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.EditorFor(model => model.RutaLogo, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.RutaLogo, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check">
                    @Html.CheckBoxFor(model => model.Activa, new { @class = "form-check-input" })
                    @Html.LabelFor(model => model.Activa, htmlAttributes: new { @class = "form-check-label" })
                </div>
            </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary" data-texto-carga="Guardando…">Guardar</button>
        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
