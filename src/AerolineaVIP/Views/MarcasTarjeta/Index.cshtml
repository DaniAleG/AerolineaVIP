@model IEnumerable<AerolineaVIP.Models.Dominio.MarcaTarjeta>
@{
    ViewBag.Title = "Marcas de tarjeta (simulación)";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Mantenimientos", "Mantenimientos", "Admin")</li>
    <li class="breadcrumb-item active" aria-current="page">Marcas de tarjeta (simulación)</li>
</ol></nav>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h1 class="h3 mb-0">Marcas de tarjeta (simulación)</h1>
    @if (User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario))
    {
        @Html.ActionLink("Crear nuevo", "Create", null, new { @class = "btn btn-primary" })
    }
</div>
@if (ViewBag.Nota != null)
{
    <p class="text-muted small">@ViewBag.Nota</p>
}
@if (!Model.Any())
{
    <div class="alert alert-info" role="status">No se encontraron registros.</div>
}
else
{
    <div class="table-responsive tarjeta p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th scope="col">@Html.DisplayNameFor(model => model.RutaLogo)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Codigo)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Nombre)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.LongitudNumero)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.LongitudCodigoSeguridad)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.PrefijosReferencia)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Activa)</th>
                <th scope="col" class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
@foreach (var item in Model)
{
            <tr>
                <td><img src="@Url.Content(item.RutaLogo)" alt="" class="logo-tarjeta-mini" onerror="this.style.display='none'" /></td>
                <td>@(item.Codigo)</td>
                <td>@(item.Nombre)</td>
                <td>@(item.LongitudNumero)</td>
                <td>@(item.LongitudCodigoSeguridad)</td>
                <td>@(item.PrefijosReferencia)</td>
                <td>@(item.Activa ? "Sí" : "No")</td>
                <td class="text-end text-nowrap">
                    @if (User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario)) { @Html.ActionLink("Editar", "Edit", new { id = item.Codigo }, new { @class = "btn btn-sm btn-outline-primary" }) }
                    @Html.ActionLink("Detalles", "Details", new { id = item.Codigo }, new { @class = "btn btn-sm btn-outline-secondary" })
                    @if (User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario)) { @Html.ActionLink("Eliminar", "Delete", new { id = item.Codigo }, new { @class = "btn btn-sm btn-outline-danger" }) }
                </td>
            </tr>
}
            </tbody>
        </table>
    </div>
}
