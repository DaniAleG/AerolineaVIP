@model AerolineaVIP.Models.Dominio.TramoItinerario
@{
    ViewBag.Title = "Detalle de tramo";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Tramos de itinerario", "Index")</li>
    <li class="breadcrumb-item active" aria-current="page">Detalle</li>
</ol></nav>
<h1 class="h3">Detalle de tramo</h1>
<div class="tarjeta">
    <dl class="row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ItinerarioId)</dt>
        <dd class="col-sm-8">@(Model.Itinerario.Referencia)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.VueloId)</dt>
        <dd class="col-sm-8">@("VIP" + Model.VueloId.ToString("00000") + " · " + AerolineaVIP.Servicios.Formato.Fecha(Model.Vuelo.FechaOperacion) + " · " + Model.Vuelo.Frecuencia.Ruta.AeropuertoOrigen.CodigoIATA + " → " + Model.Vuelo.Frecuencia.Ruta.AeropuertoDestino.CodigoIATA + " " + AerolineaVIP.Servicios.Formato.Hora(Model.Vuelo.Frecuencia.HoraSalida))</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Orden)</dt>
        <dd class="col-sm-8">@(Model.Orden)</dd>
    </dl>
</div>
<div class="mt-3 d-flex gap-2">
    @if ((User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario) || User.IsInRole(AerolineaVIP.RolesApp.Administrador))) { @Html.ActionLink("Editar", "Edit", new { id = Model.TramoItinerarioId }, new { @class = "btn btn-primary" }) }
    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>
