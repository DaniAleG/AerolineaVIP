@model AerolineaVIP.Models.Dominio.Ruta
@{
    ViewBag.Title = "Nuevo registro: ruta";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Rutas y tarifas", "Index")</li>
    <li class="breadcrumb-item active" aria-current="page">Crear</li>
</ol></nav>
<h1 class="h3">Nuevo registro: ruta</h1>
<p class="text-muted small">Los campos marcados con <span class="req">*</span> son obligatorios.</p>
@using (Html.BeginForm("Create", "Rutas", null, FormMethod.Post, new { @class = "tarjeta js-form-carga", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })
    <div class="row g-3">
            <div class="col-md-6">
                @Html.LabelFor(model => model.AeropuertoOrigenId, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.DropDownList("AeropuertoOrigenId", null, "Seleccione…", htmlAttributes: new { @class = "form-select" })
                @Html.ValidationMessageFor(model => model.AeropuertoOrigenId, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.AeropuertoDestinoId, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.DropDownList("AeropuertoDestinoId", null, "Seleccione…", htmlAttributes: new { @class = "form-select" })
                @Html.ValidationMessageFor(model => model.AeropuertoDestinoId, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.TarifaReferencial, htmlAttributes: new { @class = "form-label" }) <span class="req" aria-hidden="true">*</span>
                @Html.TextBoxFor(model => model.TarifaReferencial, "{0:0.00}", new { @class = "form-control", inputmode = "decimal" })
                <div class="texto-ayuda">Use coma o punto decimal.</div>
                @Html.ValidationMessageFor(model => model.TarifaReferencial, "", new { @class = "text-danger small", role = "alert" })
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check">
                    @Html.CheckBoxFor(model => model.Activa, new { @class = "form-check-input" })
                    @Html.LabelFor(model => model.Activa, htmlAttributes: new { @class = "form-check-label" })
                </div>
            </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary" data-texto-carga="Guardando…">Guardar</button>
        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
