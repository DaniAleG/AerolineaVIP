@model AerolineaVIP.Models.Dominio.Ruta
@{
    ViewBag.Title = "Detalle de ruta";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Rutas y tarifas", "Index")</li>
    <li class="breadcrumb-item active" aria-current="page">Detalle</li>
</ol></nav>
<h1 class="h3">Detalle de ruta</h1>
<div class="tarjeta">
    <dl class="row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.AeropuertoOrigenId)</dt>
        <dd class="col-sm-8">@(Model.AeropuertoOrigen.Localidad + " (" + Model.AeropuertoOrigen.CodigoIATA + ")")</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.AeropuertoDestinoId)</dt>
        <dd class="col-sm-8">@(Model.AeropuertoDestino.Localidad + " (" + Model.AeropuertoDestino.CodigoIATA + ")")</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.TarifaReferencial)</dt>
        <dd class="col-sm-8">@(AerolineaVIP.Servicios.Formato.Dinero(Model.TarifaReferencial))</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Activa)</dt>
        <dd class="col-sm-8">@(Model.Activa ? "Sí" : "No")</dd>
    </dl>
</div>
<div class="mt-3 d-flex gap-2">
    @if (User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario)) { @Html.ActionLink("Editar", "Edit", new { id = Model.RutaId }, new { @class = "btn btn-primary" }) }
    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>
