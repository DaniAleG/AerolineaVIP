@model AerolineaVIP.Models.Dominio.DatosEmisor
@{
    ViewBag.Title = "Detalle de registro del emisor";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Datos del emisor del comprobante", "Index")</li>
    <li class="breadcrumb-item active" aria-current="page">Detalle</li>
</ol></nav>
<h1 class="h3">Detalle de registro del emisor</h1>
<div class="tarjeta">
    <dl class="row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DatosEmisorId)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.DatosEmisorId)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NombreComercial)</dt>
        <dd class="col-sm-8">@(Model.NombreComercial)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Identificacion)</dt>
        <dd class="col-sm-8">@(Model.Identificacion)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Direccion)</dt>
        <dd class="col-sm-8">@(Model.Direccion)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Telefono)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Telefono)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Correo)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Correo)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.LeyendaComprobante)</dt>
        <dd class="col-sm-8">@(Model.LeyendaComprobante)</dd>
    </dl>
</div>
<div class="mt-3 d-flex gap-2">
    @if (User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario)) { @Html.ActionLink("Editar", "Edit", new { id = Model.DatosEmisorId }, new { @class = "btn btn-primary" }) }
    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>
