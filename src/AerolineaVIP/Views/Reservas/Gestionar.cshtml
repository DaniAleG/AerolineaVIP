@model DetalleReservaVM
@{
    ViewBag.Title = "Reserva " + Model.Reserva.CodigoReserva;
    var r = Model.Reserva;
}
@* Pantalla 14. Gestión y cancelación. *@
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Reservas", "MisReservas")</li>
    <li class="breadcrumb-item active" aria-current="page">@r.CodigoReserva</li>
</ol></nav>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0 me-2">Reserva @r.CodigoReserva</h1>
    <span class="@Formato.ClaseEstado(r.EstadoReservaCodigo)">@Formato.TextoEstadoReserva(r.EstadoReservaCodigo)</span>
    <span class="@Formato.ClaseEstado(Model.EstadoCompra)">Compra: @Formato.TextoEstadoCompra(Model.EstadoCompra).ToLower()</span>
</div>
<p class="text-muted">Titular: @Model.Titular @(Model.TitularCorreo != null ? "· " + Model.TitularCorreo : "")</p>

@Html.Partial("_EstadosOperacion", Model)

<div class="tarjeta mb-3">
    <h2 class="tarjeta-titulo">Itinerario, pasajeros y asientos</h2>
    @Html.Partial("_DetalleReserva", Model)
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    @if (r.EstadoReservaCodigo == "PENDIENTE")
    {
        <a class="btn btn-primary" href="@Url.Action("Pagar", "Compras", new { id = r.ReservaId })">Pagar</a>
    }
    @if (Model.Comprobantes.Any())
    {
        <a class="btn btn-outline-primary" href="@Url.Action("Index", "Comprobantes", new { Buscar = r.CodigoReserva })">Ver comprobantes</a>
    }
    @if (r.EstadoReservaCodigo == "CONFIRMADA")
    {
        <a class="btn btn-outline-primary" href="@Url.Action("Index", "CheckIn", new { codigo = r.CodigoReserva })">Check-in</a>
    }
    <a class="btn btn-outline-secondary" href="@Url.Action("MisReservas")">Regresar</a>
</div>

<section class="tarjeta" aria-labelledby="tituloCancelacion">
    <h2 id="tituloCancelacion" class="h5">Cancelación</h2>
    <div class="border rounded p-3 small mb-3 bg-light">@Model.CondicionesCancelacion</div>
    @if (!Model.PuedeCancelar)
    {
        <div class="alert alert-info mb-0" role="status"><strong>Información:</strong> @Model.MotivoNoCancelar</div>
    }
    else
    {
        using (Html.BeginForm("Cancelar", "Reservas", new { id = r.ReservaId }, FormMethod.Post, new { id = "formCancelar", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label for="motivo" class="form-label">Motivo de cancelación @if (Model.RequiereMotivo) { <span class="req">*</span> } else { <span class="text-muted fw-normal">(opcional)</span> }</label>
                <textarea id="motivo" name="motivo" class="form-control" rows="3" maxlength="300" aria-describedby="ayudaMotivo"
                          data-val="@(Model.RequiereMotivo ? "true" : "false")" data-val-required="Indique el motivo de la cancelación."
                          data-val-length="El motivo debe tener entre 10 y 300 caracteres." data-val-length-min="10" data-val-length-max="300"></textarea>
                <div id="ayudaMotivo" class="texto-ayuda">Describa el motivo (10–300 caracteres). En reservas pagadas acompaña al reverso simulado del pago.</div>
                <span class="field-validation-valid" data-valmsg-for="motivo" data-valmsg-replace="true" role="alert"></span>
            </div>
            <button type="button" class="btn btn-outline-danger" id="btnSolicitarCancelacion">Solicitar cancelación</button>

            <div class="modal fade" id="modalCancelar" tabindex="-1" aria-labelledby="tituloModalCancelar" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title h5" id="tituloModalCancelar">Confirmar cancelación</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-warning mb-2" role="alert">
                                <strong>Advertencia:</strong> La cancelación liberará los asientos @Model.AsientosTexto. Esta acción no se puede deshacer.
                            </div>
                            @if (r.EstadoReservaCodigo == "CONFIRMADA")
                            {
                                <p class="small mb-0">Se anulará la compra, se registrará el reverso SIMULADO del pago y se emitirá una nota de crédito académica. Las condiciones de reembolso están pendientes de aprobación.</p>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-danger" data-texto-carga="Procesando solicitud…">Confirmar solicitud</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</section>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $('#btnSolicitarCancelacion').on('click', function () {
            if ($('#formCancelar').valid()) {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalCancelar')).show();
            }
        });
    </script>
}
