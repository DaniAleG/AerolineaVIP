@model AerolineaVIP.Models.Dominio.TipoDocumentoIdentidad
@{
    ViewBag.Title = "Detalle de tipo de documento";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Tipos de documento", "Index")</li>
    <li class="breadcrumb-item active" aria-current="page">Detalle</li>
</ol></nav>
<h1 class="h3">Detalle de tipo de documento</h1>
<div class="tarjeta">
    <dl class="row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Codigo)</dt>
        <dd class="col-sm-8">@(Model.Codigo)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Descripcion)</dt>
        <dd class="col-sm-8">@(Model.Descripcion)</dd>
    </dl>
</div>
<div class="mt-3 d-flex gap-2">
    @if (User.IsInRole(AerolineaVIP.RolesApp.SuperUsuario)) { @Html.ActionLink("Editar", "Edit", new { id = Model.Codigo }, new { @class = "btn btn-primary" }) }
    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>
