@model MapaAsientosVM
@* Mapa de asientos del Phenom 300E. El color sale del estado que envía el servidor. *@
@functions {
    private static int ColumnaEscritorio(int fila) { return fila == 1 ? 2 : fila == 2 ? 3 : fila == 3 ? 5 : 6; }
    private static int FilaMovil(int fila) { return fila == 1 ? 2 : fila == 2 ? 3 : fila == 3 ? 5 : 6; }
}
<div class="avion">
    <div class="cabina mapa" id="mapa_@Model.Tramo" data-tramo="@Model.Tramo" role="group" aria-label="Distribución de asientos de la aeronave">
        <div class="zona" style="--c:1;--r:1 / span 3;--mc:1 / span 3;--mr:1">Cabina de mando<br />(proa)</div>
        <div class="zona puerta" style="--c:2;--r:3;--mc:1;--mr:2">Puerta de acceso</div>
        <div class="zona mesa" style="--c:4;--r:1;--mc:3;--mr:4">Mesa</div>
        <div class="zona mesa" style="--c:4;--r:3;--mc:1;--mr:4">Mesa</div>
        <div class="zona pasillo" style="--c:2 / span 5;--r:2;--mc:2;--mr:2 / span 5">PASILLO</div>
        <div class="zona" style="--c:7;--r:1;--mc:3;--mr:7">Baño</div>
        <div class="zona" style="--c:7;--r:3;--mc:1;--mr:7">Equipaje / servicio</div>

        @foreach (var a in Model.Asientos)
        {
            var clase = Model.MostrarEstados ? a.ClaseCss : "asiento-neutro";
            var estilo = "--c:" + ColumnaEscritorio(a.Fila) + ";--r:" + (a.Lado == "D" ? 1 : 3)
                         + ";--mc:" + (a.Lado == "D" ? 3 : 1) + ";--mr:" + FilaMovil(a.Fila);
            var bloqueado = a.EstadoVisual != "DISPONIBLE";
            if (Model.Interactivo)
            {
                <button type="button" class="asiento @clase" style="@estilo"
                        data-numero="@a.NumeroAsiento" data-codigo="@a.Codigo" data-estado="@a.EstadoVisual"
                        data-tramo="@Model.Tramo" data-ubicacion="@("Ventanilla lado " + Formato.NombreLado(a.Lado))"
                        aria-label="@a.Descripcion" aria-pressed="false"
                        disabled="@(bloqueado ? "disabled" : null)" aria-disabled="@(bloqueado ? "true" : "false")">
                    <span class="codigo">@a.Codigo</span>
                    <span class="estado-texto">@a.TextoEstado</span>
                </button>
            }
            else
            {
                <div class="asiento @clase" style="@estilo" data-numero="@a.NumeroAsiento" data-codigo="@a.Codigo"
                     data-estado="@a.EstadoVisual" role="img" aria-label="@(Model.MostrarEstados ? a.Descripcion : "Asiento " + a.Codigo + ": " + a.Ubicacion)" title="@a.Ubicacion">
                    <span class="codigo">@a.Codigo</span>
                    @if (Model.MostrarEstados)
                    {
                        <span class="estado-texto">@a.TextoEstado</span>
                    }
                </div>
            }
        }
    </div>
</div>
@if (Model.MostrarEstados)
{
    <ul class="leyenda" aria-label="Leyenda de estados de los asientos">
        <li><span class="muestra asiento-disponible"></span> Verde · Disponible (puede seleccionarse)</li>
        <li><span class="muestra asiento-reservado"></span> Morado · Reservado (pendiente de pago, no seleccionable)</li>
        <li><span class="muestra asiento-ocupado"></span> Rojo · Ocupado (compra pagada, no seleccionable)</li>
        @if (Model.Interactivo)
        {
            <li><span class="muestra asiento-seleccionado"></span> Borde negro grueso + ✓ · Su selección actual (aún no reservada)</li>
        }
    </ul>
}
