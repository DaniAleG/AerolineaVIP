@model AerolineaVIP.Models.Dominio.Frecuencia
@{
    ViewBag.Title = "Eliminar frecuencia";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Frecuencias aprobadas", "Index")</li>
    <li class="breadcrumb-item active" aria-current="page">Eliminar</li>
</ol></nav>
<h1 class="h3">Eliminar frecuencia</h1>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert"><strong>Error:</strong> @ViewBag.Error</div>
}
else
{
    <div class="alert alert-warning" role="alert"><strong>Advertencia:</strong> ¿Está seguro de que desea eliminar este registro? Esta acción no se puede deshacer.</div>
}
<div class="tarjeta">
    <dl class="row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.RutaId)</dt>
        <dd class="col-sm-8">@(Model.Ruta.AeropuertoOrigen.CodigoIATA + " → " + Model.Ruta.AeropuertoDestino.CodigoIATA)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DiaSemana)</dt>
        <dd class="col-sm-8">@(AerolineaVIP.Servicios.Formato.NombreDia(Model.DiaSemana))</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.HoraSalida)</dt>
        <dd class="col-sm-8">@(AerolineaVIP.Servicios.Formato.Horario(Model.HoraSalida, Model.HoraLlegada))</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.HoraLlegada)</dt>
        <dd class="col-sm-8">@AerolineaVIP.Servicios.Formato.Hora(Model.HoraLlegada)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Activa)</dt>
        <dd class="col-sm-8">@(Model.Activa ? "Sí" : "No")</dd>
    </dl>
</div>
@using (Html.BeginForm("Delete", "Frecuencias", new { id = Model.FrecuenciaId }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-danger">Eliminar</button>
        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}
