@model AerolineaVIP.Models.Dominio.Pasajero
@{
    ViewBag.Title = "Eliminar pasajero";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index", "Admin")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Pasajeros", "Index")</li>
    <li class="breadcrumb-item active" aria-current="page">Eliminar</li>
</ol></nav>
<h1 class="h3">Eliminar pasajero</h1>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert"><strong>Error:</strong> @ViewBag.Error</div>
}
else
{
    <div class="alert alert-warning" role="alert"><strong>Advertencia:</strong> ¿Está seguro de que desea eliminar este registro? Esta acción no se puede deshacer.</div>
}
<div class="tarjeta">
    <dl class="row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.TipoDocumentoCodigo)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.TipoDocumentoCodigo)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NumeroDocumento)</dt>
        <dd class="col-sm-8">@(Model.TipoDocumentoIdentidad.Descripcion + " " + Model.NumeroDocumento)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombres)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Nombres)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Apellidos)</dt>
        <dd class="col-sm-8">@(Model.Apellidos + ", " + Model.Nombres)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.FechaNacimiento)</dt>
        <dd class="col-sm-8">@AerolineaVIP.Servicios.Formato.Fecha(Model.FechaNacimiento)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Correo)</dt>
        <dd class="col-sm-8">@(Model.Correo)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Telefono)</dt>
        <dd class="col-sm-8">@(Model.Telefono)</dd>
    </dl>
</div>
@using (Html.BeginForm("Delete", "Pasajeros", new { id = Model.PasajeroId }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-danger">Eliminar</button>
        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}
