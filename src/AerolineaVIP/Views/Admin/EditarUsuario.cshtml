@model EditarUsuarioVM
@{
    ViewBag.Title = "Editar usuario";
}
<nav aria-label="Ruta de navegación"><ol class="breadcrumb">
    <li class="breadcrumb-item">@Html.ActionLink("Administración", "Index")</li>
    <li class="breadcrumb-item">@Html.ActionLink("Usuarios", "Gestion", new { tab = "usuarios" })</li>
    <li class="breadcrumb-item active" aria-current="page">Editar</li>
</ol></nav>
<h1 class="h3">Editar usuario «@Model.UserName»</h1>
@using (Html.BeginForm("EditarUsuario", "Admin", FormMethod.Post, new { @class = "tarjeta", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })
    <div class="row g-3">
        <div class="col-md-6">
            @Html.LabelFor(m => m.Nombres, new { @class = "form-label" }) <span class="req">*</span>
            @Html.TextBoxFor(m => m.Nombres, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Nombres)
        </div>
        <div class="col-md-6">
            @Html.LabelFor(m => m.Apellidos, new { @class = "form-label" }) <span class="req">*</span>
            @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Apellidos)
        </div>
        <div class="col-md-6">
            @Html.LabelFor(m => m.Email, new { @class = "form-label" }) <span class="req">*</span>
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
            @Html.ValidationMessageFor(m => m.Email)
        </div>
        <div class="col-md-6">
            @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", type = "tel" })
            @Html.ValidationMessageFor(m => m.PhoneNumber)
        </div>
    </div>
    <p class="texto-ayuda mt-3">El rol solo puede cambiarlo el SuperUsuario desde la lista de usuarios.</p>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" data-texto-carga="Guardando…">Guardar</button>
        <a class="btn btn-outline-secondary" href="@Url.Action("Gestion", new { tab = "usuarios" })">Cancelar</a>
    </div>
}
@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
